      "source": [
        "import pandas as pd\n",
        "from ydata_profiling import ProfileReport\n",
        "\n",
        "df_global = pd.read_csv(\"data/dataset_global_fao.csv\")\n",
        "\n",
        "profile = ProfileReport(\n",
        "    df_global,\n",
        "    title=\"Rapport EDA - Dataset FAO global\",\n",
        "    explorative=True\n",
        ")\n",
        "\n",
        "profile.to_file(\"rapport_eda_auto.html\")"
      ]
    }
  ],
